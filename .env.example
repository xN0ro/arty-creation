# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM=ARTY Création <noreply@your-domain.ca>
EMAIL_REPLY_TO=contact@your-domain.ca
ARTY_PUBLIC_URL=https://your-site.onrender.com
ARTY_TIME_ZONE=America/Toronto

# Existing ticket-only names remain supported for backwards compatibility:
# TICKET_EMAIL_FROM=ARTY Création <noreply@your-domain.ca>
# TICKET_EMAIL_REPLY_TO=contact@your-domain.ca


# Google Calendar CRM follow-up sync (recommended: OAuth, no service-account key)
# Create an OAuth 2.0 Web application client in Google Cloud.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Optional; defaults to ARTY_PUBLIC_URL + /api/google-calendar/oauth/callback
GOOGLE_CALENDAR_REDIRECT_URI=
# Use a manager-owned secondary calendar ID, or "primary" to use the connected account's primary calendar.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIME_ZONE=America/Toronto

# Legacy service-account mode remains supported when organization policy allows keys.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
